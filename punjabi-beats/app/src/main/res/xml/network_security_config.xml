<?xml version="1.0" encoding="utf-8"?>
<network-security-config>
    <!-- Podcast RSS feeds and some indie stream CDNs are still plain http. -->
    <base-config cleartextTrafficPermitted="true">
        <trust-anchors>
            <certificates src="system" />
        </trust-anchors>
    </base-config>
</network-security-config>
